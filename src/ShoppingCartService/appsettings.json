{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ShoppingCartDb": "Host=postgres-db;Port=5432;Database=ShoppingCartDb;Username=user;Password=password;"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*:/api/*",
        "Period": "10s",
        "Limit": 5
      },
      {
        "Endpoint": "post:/api/carts/items",
        "Period": "1m",
        "Limit": 30
      },
      {
        "Endpoint": "post:/api/carts/*_checkout",
        "Period": "1m",
        "Limit": 10
      }
    ]
  }
}
